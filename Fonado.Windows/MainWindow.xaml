<Window x:Class="Fonado.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:brand="using:Fonado.Windows.Controls" Title="Fonado">
 <Grid RequestedTheme="Light" Background="{ThemeResource FonadoSurface}">
  <NavigationView x:Name="DesktopNavigation" PaneDisplayMode="Left" OpenPaneLength="220" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="True" SelectionChanged="DesktopNavigationChanged">
   <NavigationView.MenuItems>
    <NavigationViewItem x:Name="ConversationTab" Content="Gespräch" Tag="call" Visibility="Collapsed"><NavigationViewItem.Icon><BitmapIcon UriSource="ms-appx:///Assets/Brand/Phone.png" Width="24" Height="24"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Name="DialpadTab" Content="Wählen" Tag="dial"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80A;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem x:Name="FavoritesTab" Content="Favoriten" Tag="favorites" Icon="Favorite"/>
    <NavigationViewItem x:Name="RecentsTab" Content="Anrufliste" Tag="recents" Icon="Clock"/>
    <NavigationViewItem Content="Kontakte" Tag="contacts" Icon="Contact"/>
    <NavigationViewItem Content="Team" Tag="team" Icon="People"/>
    <NavigationViewItem x:Name="AccountTab" Content="Konto" Tag="account" Icon="ContactInfo"/>
   </NavigationView.MenuItems>
   <NavigationView.PaneFooter>
    <StackPanel x:Name="SidebarFooter" Spacing="6" Margin="4,12,12,20">
     <Grid x:Name="SidebarStatus" MinHeight="32" ColumnSpacing="8" AutomationProperties.LiveSetting="Polite">
      <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <SymbolIcon x:Name="SidebarConnectedIcon" Symbol="Accept" Foreground="{ThemeResource FonadoStatusGreen}" Visibility="Collapsed" AutomationProperties.Name="{Binding Text, ElementName=Status}"/>
      <SymbolIcon x:Name="SidebarDisconnectedIcon" Symbol="Important" Foreground="{ThemeResource FonadoMuted}" AutomationProperties.Name="{Binding Text, ElementName=Status}"/>
      <TextBlock x:Name="Status" Grid.Column="1" Text="Nicht angemeldet" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{ThemeResource FonadoMuted}" AutomationProperties.LiveSetting="Polite"/>
     </Grid>
     <Grid x:Name="SidebarIdentity" MinHeight="40" ColumnSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <SymbolIcon Symbol="ContactInfo" Foreground="{ThemeResource FonadoMuted}"/>
      <StackPanel x:Name="SidebarIdentityText" Grid.Column="1" Spacing="3" VerticalAlignment="Center">
       <TextBlock x:Name="CompanyName" FontSize="12" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="ExtensionLabel" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource FonadoMuted}"/>
      </StackPanel>
     </Grid>
     <Button x:Name="DndButton" Click="DndClicked" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="36" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6">
      <Grid x:Name="DndContent" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <FontIcon x:Name="DndInactiveIcon" Glyph="&#xE7ED;" FontSize="20" Foreground="{ThemeResource FonadoMuted}"/>
       <FontIcon x:Name="DndActiveIcon" Glyph="&#xE7ED;" FontSize="20" Foreground="{ThemeResource FonadoAccent}" Visibility="Collapsed"/>
       <TextBlock x:Name="DndLabel" Grid.Column="1" Text="Nicht stören" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"/>
      </Grid>
     </Button>
     <Button x:Name="ReconnectButton" Click="ReconnectClicked" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="36" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" ToolTipService.ToolTip="Telefonie erneut verbinden" AutomationProperties.Name="Telefonie erneut verbinden">
      <Grid x:Name="ReconnectContent" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <SymbolIcon Symbol="Sync" Foreground="{ThemeResource FonadoMuted}"/>
       <TextBlock x:Name="ReconnectLabel" Grid.Column="1" Text="Erneut verbinden" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"/>
      </Grid>
     </Button>
     <brand:BrandLogo x:Name="SidebarLogo" Width="96" Height="36" HorizontalAlignment="Left" Margin="4,12,0,0"/>
    </StackPanel>
   </NavigationView.PaneFooter>
   <Grid RowSpacing="0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border BorderBrush="{ThemeResource FonadoLine}" BorderThickness="0,0,0,1" Padding="28,16">
     <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="PageTitle" Text="Anmelden" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
       <Button x:Name="PreviewCallButton" Content="Gesprächsvorschau" Click="PreviewCallClicked" Visibility="Collapsed"/>
       <Button x:Name="PreviewMiniButton" Content="Mini" Click="PreviewMiniClicked" Visibility="Collapsed"/>
       <Button x:Name="PreviewQuickButton" Content="Tray" Visibility="Collapsed"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Bereit · Vorschau" Tag="ready" Click="PreviewQuickClicked"/><MenuFlyoutItem Text="Eingehend · Vorschau" Tag="incoming" Click="PreviewQuickClicked"/><MenuFlyoutItem Text="Gespräch · Vorschau" Tag="call" Click="PreviewQuickClicked"/></MenuFlyout></Button.Flyout></Button>
       <Button x:Name="ProfileButton" Click="ProfilesClicked" Visibility="Collapsed" MaxWidth="180" ToolTipService.ToolTip="Geräte für eingehende Anrufe auswählen" AutomationProperties.Name="Anrufprofile">
        <StackPanel Orientation="Horizontal" Spacing="8"><BitmapIcon UriSource="ms-appx:///Assets/Brand/Devices.png" Width="24" Height="24"/><TextBlock x:Name="ProfileName" Text="Anrufprofile" MaxWidth="115" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></StackPanel>
       </Button>
       <Button Content="Audio" Click="AudioClicked" ToolTipService.ToolTip="Audioeinstellungen"/>
      </StackPanel>
      <Button x:Name="CallReturnButton" Grid.Row="1" Grid.ColumnSpan="2" Content="Zurück zum Gespräch" Click="ReturnToCallClicked" Visibility="Collapsed" Margin="0,12,0,0" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch"/>
     </Grid>
    </Border>
    <ContentControl x:Name="Actions" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
     <Grid>
     <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <Grid Padding="36">
       <StackPanel x:Name="AccountContainer" Spacing="22" MaxWidth="580" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel x:Name="LoginPanel" Spacing="18">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Damit Gespräche mehr bewegen." FontSize="30" FontWeight="Bold" TextWrapping="Wrap" Foreground="{ThemeResource FonadoInk}"/>
                                <TextBlock Text="Willkommen bei Fonado. Melde dich an – deine Firma und Nebenstelle richten wir automatisch ein." TextWrapping="Wrap" Foreground="{ThemeResource FonadoMuted}"/>
                            </StackPanel>
                            <TextBox x:Name="Email" Header="E-Mail-Adresse" PlaceholderText="name@firma.at" InputScope="EmailSmtpAddress" TextChanged="EmailChanged" KeyDown="EmailKeyDown" AutomationProperties.Name="E-Mail-Adresse"/>
                            <Button x:Name="SendCodeButton" Content="Bestätigungscode senden" Click="SendCodeClicked" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" CornerRadius="10" Padding="16,12"/>
                            <CheckBox x:Name="RememberDevice" Content="Auf diesem PC angemeldet bleiben" IsChecked="True"/>
                            <StackPanel x:Name="CodePanel" Spacing="12" Visibility="Collapsed">
                                <TextBox x:Name="Code" Header="Sechsstelliger Bestätigungscode" MaxLength="6" InputScope="Number" KeyDown="CodeKeyDown" AutomationProperties.Name="Bestätigungscode"/>
                                <Button Content="Bestätigen und anmelden" Click="VerifyClicked" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" CornerRadius="10"/>
                            </StackPanel>
                            <Expander Header="Mit Passwort anmelden" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      Background="{ThemeResource FonadoSurface}" BorderBrush="{ThemeResource FonadoLine}" Padding="16" CornerRadius="8">
                                <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                                    <PasswordBox x:Name="Password" Header="Passwort" HorizontalAlignment="Stretch" KeyDown="PasswordKeyDown" AutomationProperties.Name="Passwort"/>
                                    <Button Content="Anmelden" Click="PasswordClicked" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" CornerRadius="8" Padding="16,12"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        <StackPanel x:Name="SetupPanel" Spacing="18" Visibility="Collapsed">
                            <TextBlock Text="Dein Anschluss." FontSize="30" FontWeight="Bold" Foreground="{ThemeResource FonadoInk}"/>
                            <TextBlock x:Name="SetupDescription" TextWrapping="Wrap" Foreground="{ThemeResource FonadoMuted}"/>
                            <ComboBox x:Name="Companies" Header="Firma und Nebenstelle" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" SelectionChanged="CompanyChanged"/>
                            <Button x:Name="ConnectButton" Content="Nebenstelle einrichten" Click="ConnectClicked" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" CornerRadius="10"/>
                            <Button Content="Zuweisung aktualisieren" Click="RefreshClicked" HorizontalAlignment="Stretch"/>
                        </StackPanel>

        <StackPanel x:Name="SignedInPanel" Spacing="18" Visibility="Collapsed">
         <TextBlock Text="Dein Fonado-Konto" FontSize="30" FontWeight="Bold"/>
         <TextBlock x:Name="AccountEmail" Foreground="{ThemeResource FonadoMuted}"/>
         <TextBlock Text="Firma und Nebenstelle findest du in der Seitenleiste. Fonado bleibt beim Schließen des Fensters im Infobereich erreichbar. Mit „Fonado beenden“ schließt du die App vollständig." TextWrapping="Wrap"/>
         <TextBlock x:Name="RememberedStatus" TextWrapping="Wrap" Foreground="{ThemeResource FonadoMuted}"/><Button x:Name="SetAccountPasswordButton" Content="Passwort festlegen / ändern" Click="SetPasswordClicked" Visibility="Collapsed"/>
         <Button Content="Firma / Nebenstelle wechseln" Click="ChangeCompanyClicked"/>
         <Button Content="Status aktualisieren" Click="RefreshClicked"/>
         <HyperlinkButton Content="Kundenbereich öffnen" NavigateUri="https://app.fonado.ai/kunden/"/>
        </StackPanel>
        <Border BorderBrush="{ThemeResource FonadoLine}" BorderThickness="1" CornerRadius="8" Padding="18">
         <StackPanel Spacing="12">
          <TextBlock Text="Fenster &amp; Infobereich" FontSize="18" FontWeight="SemiBold"/>
          <ToggleSwitch x:Name="MinimizeToTraySwitch" Header="Beim Minimieren im Infobereich weiterlaufen" OnContent="Aktiv" OffContent="In der Taskleiste minimieren" Toggled="MinimizeToTrayToggled"/>
          <TextBlock Text="Fonado bleibt rechts unten erreichbar. Ein Klick auf das Symbol öffnet den Schnellzugriff mit Direktwahl, Profil und Gesprächssteuerung. Rechtsklick zeigt das Menü. Bei einem Anruf erscheint das kleine Gesprächsfenster." TextWrapping="Wrap" Foreground="{ThemeResource FonadoMuted}" FontSize="13"/>
          <TextBlock x:Name="TrayStatusLabel" Text="Nicht angemeldet" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
          <StackPanel Spacing="8"><Button Content="Schnellzugriff öffnen" Click="QuickAccessClicked" ToolTipService.ToolTip="Direktwahl und Gesprächssteuerung wie am Symbol rechts unten"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Schnellmenü öffnen" Click="TrayMenuClicked"/><Button Content="In den Hintergrund" Click="HideInTrayClicked"/></StackPanel></StackPanel>
          <TextBlock Text="Deinen Verbindungs- und Gesprächsstatus siehst du beim Darüberfahren und im Schnellzugriff." TextWrapping="Wrap" Foreground="{ThemeResource FonadoMuted}" FontSize="12"/>
          <TextBlock Text="Falls das Symbol verborgen ist, findest du es unter dem Pfeil rechts unten. Mit „Fonado beenden“ schließt du die App vollständig." TextWrapping="Wrap" Foreground="{ThemeResource FonadoMuted}" FontSize="12"/>
         </StackPanel>
        </Border>
        <Button Content="Fonado beenden" Click="QuitClicked"/>
        <Button x:Name="SignOutButton" Content="Abmelden" Click="SignOutClicked" Visibility="Collapsed"/>
        <HyperlinkButton Content="Quellcode und Lizenzen" NavigateUri="https://github.com/ivama-dev/fonado-windows/releases/tag/v0.1.2" HorizontalAlignment="Left" FontSize="13"/>
       </StackPanel>
       <Grid x:Name="PhonePanel" Visibility="Collapsed">
        <StackPanel x:Name="DialpadPanel" Spacing="22" MaxWidth="340" HorizontalAlignment="Stretch" VerticalAlignment="Center">
         <BitmapIcon UriSource="ms-appx:///Assets/Brand/Phone.png" Width="40" Height="40" Foreground="{ThemeResource FonadoAccent}"/>
         <TextBlock Text="Wen möchtest du anrufen?" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
         <Grid Background="{ThemeResource FonadoBackground}" CornerRadius="12" Padding="6">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="Number" PlaceholderText="Nummer oder Nebenstelle" MaxLength="64" FontSize="20" BorderThickness="0" Background="Transparent" InputScope="TelephoneNumber" TextChanged="NumberChanged" KeyDown="NumberKeyDown" AutomationProperties.Name="Zielrufnummer"/>
          <Button x:Name="DeleteButton" Grid.Column="1" Click="DeleteClicked" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Letzte Ziffer löschen"><FontIcon Glyph="&#xE94F;" FontSize="18"/></Button>
         </Grid>
         <Grid x:Name="Keypad" ColumnSpacing="10" RowSpacing="10">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
         </Grid>
         <Button x:Name="PlusButton" Content="+ Internationale Vorwahl" Click="PlusClicked" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="12"/>
         <Button x:Name="CallButton" Click="CallClicked" IsEnabled="False" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="44" CornerRadius="8" ToolTipService.ToolTip="Anrufen (Enter)">
          <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE717;" FontSize="18"/><TextBlock Text="Anrufen"/></StackPanel>
         </Button>
        </StackPanel>
        <StackPanel x:Name="FavoritesPanel" Visibility="Collapsed" Spacing="18">
         <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button x:Name="AddFavoriteGroupButton" Click="AddFavoriteGroupClicked" AutomationProperties.Name="Gruppe anlegen"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" FontSize="16"/><TextBlock Text="Gruppe anlegen"/></StackPanel></Button>
          <Button x:Name="AddFavoriteButton" Content="Favorit hinzufügen" Click="AddFavoriteClicked"/>
         </StackPanel>
         <TextBlock x:Name="FavoriteOrderHint" Text="Ziehe Gruppen und Favoriten am Griff in die gewünschte Reihenfolge. Weitere Aktionen findest du unter ···." FontSize="12" Foreground="{ThemeResource FonadoMuted}" TextWrapping="Wrap"/>
         <TextBlock x:Name="NoFavorites" Text="Deine Favoriten&#x0a;Füge Kontakte hinzu, um sie hier schnell anzurufen." TextWrapping="Wrap" TextAlignment="Center" Margin="0,60,0,0" Foreground="{ThemeResource FonadoMuted}"/>
         <ItemsControl x:Name="FavoriteSections" HorizontalContentAlignment="Stretch">
          <ItemsControl.ItemTemplate><DataTemplate>
           <StackPanel Spacing="4" Margin="0,0,0,18" Tag="{Binding}">
            <Border Padding="0,4" Background="Transparent" BorderBrush="{ThemeResource FonadoLine}" BorderThickness="0,0,0,1" Tag="{Binding}" Visibility="{Binding HeaderVisibility}">
             <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Thumb Grid.ColumnSpan="2" Tag="{Binding}" IsEnabled="{Binding CanDrag}" DragStarted="FavoriteGroupThumbStarted" DragDelta="FavoriteGroupThumbDelta" DragCompleted="FavoriteGroupThumbCompleted" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
               <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent" ColumnSpacing="8" Padding="0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE784;" FontSize="16" Foreground="{ThemeResource FonadoMuted}" Visibility="{Binding ActionsVisibility}" ToolTipService.ToolTip="Gruppe ziehen, um sie zu verschieben"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
               </Grid></ControlTemplate></Thumb.Template>
              </Thumb>
              <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="12" Foreground="{ThemeResource FonadoMuted}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" Visibility="{Binding ActionsVisibility}">
               <Button Tag="{Binding}" Click="FavoriteGroupUpClicked" IsEnabled="{Binding CanMoveUp}" Background="Transparent" BorderThickness="0" Padding="7" ToolTipService.ToolTip="Gruppe nach oben" AutomationProperties.Name="Gruppe nach oben"><FontIcon Glyph="&#xE70E;" FontSize="12"/></Button>
               <Button Tag="{Binding}" Click="FavoriteGroupDownClicked" IsEnabled="{Binding CanMoveDown}" Background="Transparent" BorderThickness="0" Padding="7" ToolTipService.ToolTip="Gruppe nach unten" AutomationProperties.Name="Gruppe nach unten"><FontIcon Glyph="&#xE70D;" FontSize="12"/></Button>
               <Button Tag="{Binding}" Click="FavoriteGroupMoreClicked" Background="Transparent" BorderThickness="0" Padding="7" ToolTipService.ToolTip="Gruppe bearbeiten" AutomationProperties.Name="Gruppe bearbeiten"><FontIcon Glyph="&#xE712;" FontSize="16"/></Button>
              </StackPanel>
             </Grid>
            </Border>
            <TextBlock Text="Noch keine Favoriten – ziehe einen Kontakt auf den Gruppennamen oder wähle seine Gruppe unter ···." Visibility="{Binding EmptyVisibility}" Foreground="{ThemeResource FonadoMuted}" FontSize="12" TextWrapping="Wrap" Margin="4,10"/>
            <ListView ItemsSource="{Binding Items}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="FavoriteClicked" HorizontalContentAlignment="Stretch">
             <ListView.ItemTemplate><DataTemplate>
              <Border Padding="4,10" Tag="{Binding Favorite}" Background="Transparent" BorderThickness="0">
               <Border.ContextFlyout><MenuFlyout>
                <MenuFlyoutItem Text="Bearbeiten" Tag="{Binding Favorite}" Click="EditFavoriteClicked"/>
                <MenuFlyoutItem Text="In Gruppe verschieben …" Tag="{Binding Favorite}" Click="MoveFavoriteClicked"/>
                <MenuFlyoutItem Text="Nach oben" Tag="{Binding Favorite}" Click="FavoriteUpClicked"/>
                <MenuFlyoutItem Text="Nach unten" Tag="{Binding Favorite}" Click="FavoriteDownClicked"/>
                <MenuFlyoutSeparator/><MenuFlyoutItem Text="Entfernen" Tag="{Binding Favorite}" Click="RemoveFavoriteClicked"/>
               </MenuFlyout></Border.ContextFlyout>
               <Grid ColumnSpacing="10">
               <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
               <Thumb Tag="{Binding Favorite}" DragStarted="FavoriteThumbStarted" DragDelta="FavoriteThumbDelta" DragCompleted="FavoriteThumbCompleted" VerticalAlignment="Center" Height="36" AutomationProperties.Name="Favorit ziehen, um ihn zu verschieben">
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><FontIcon Glyph="&#xE784;" FontSize="14" Foreground="{ThemeResource FonadoMuted}"/></Grid></ControlTemplate></Thumb.Template>
               </Thumb>
               <Border Grid.Column="1" Width="38" Height="38" CornerRadius="19" Background="{ThemeResource FonadoTint}"><TextBlock Text="{Binding Initials}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{ThemeResource FonadoAccent}" FontWeight="SemiBold"/></Border>
               <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Number}" Foreground="{ThemeResource FonadoMuted}"/>
                <StackPanel Orientation="Horizontal" Spacing="7" Visibility="{Binding Phone.Visibility}"><Ellipse Width="7" Height="7" Fill="{Binding Phone.Brush}" VerticalAlignment="Center"/><TextBlock Text="{Binding Phone.Text}" Foreground="{Binding Phone.Brush}" FontSize="12"/></StackPanel>
                <TextBlock Text="{Binding Phone.Detail}" Visibility="{Binding Phone.DetailVisibility}" Foreground="{ThemeResource FonadoMuted}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Phone.Detail}"/>
               </StackPanel>
               <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE717;" FontSize="18" Foreground="{ThemeResource FonadoAccent}"/>
                <Button Tag="{Binding Favorite}" Click="FavoriteMoreClicked" Background="Transparent" BorderThickness="0" Padding="8" ToolTipService.ToolTip="Favorit bearbeiten oder verschieben" AutomationProperties.Name="Favorit bearbeiten oder verschieben"><FontIcon Glyph="&#xE712;" FontSize="16"/></Button>
               </StackPanel>
              </Grid></Border>
             </DataTemplate></ListView.ItemTemplate>
            </ListView>
           </StackPanel>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
        </StackPanel>
        <StackPanel x:Name="RecentsPanel" Visibility="Collapsed" Spacing="18">
         <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="Deine Anrufe" FontSize="26" FontWeight="SemiBold"/>
          <Button Grid.Column="1" Click="RefreshHistoryClicked" ToolTipService.ToolTip="Anrufliste aktualisieren" AutomationProperties.Name="Anrufliste aktualisieren"><SymbolIcon Symbol="Refresh"/></Button>
          <Button x:Name="ClearHistoryButton" Grid.Column="2" Content="Liste löschen" Click="ClearHistoryClicked"/>
         </Grid>
         <SelectorBar x:Name="HistoryFilter" SelectionChanged="HistoryFilterChanged" HorizontalAlignment="Left" AutomationProperties.Name="Anrufe filtern">
          <SelectorBarItem Text="Alle" IsSelected="True"/>
          <SelectorBarItem x:Name="MissedHistoryFilter" Text="Verpasst"/>
         </SelectorBar>
         <TextBox x:Name="HistorySearch" PlaceholderText="Rufnummer suchen" TextChanged="HistorySearchChanged" AutomationProperties.Name="Anrufliste durchsuchen"/>
         <TextBlock x:Name="HistoryEmpty" Text="Noch keine Anrufe. Deine Gespräche auf diesem PC erscheinen hier." TextWrapping="Wrap" Margin="0,24" Foreground="{ThemeResource FonadoMuted}"/>
         <ListView x:Name="HistoryList" MaxHeight="520" SelectionMode="None" IsItemClickEnabled="True" ItemClick="HistoryClicked" HorizontalContentAlignment="Stretch">
          <ListView.ItemTemplate><DataTemplate><Grid Padding="4,10" ColumnSpacing="12">
           <Grid.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Aus Anrufliste löschen" Tag="{Binding}" Click="DeleteHistoryClicked"><MenuFlyoutItem.Icon><SymbolIcon Symbol="Delete"/></MenuFlyoutItem.Icon></MenuFlyoutItem></MenuFlyout></Grid.ContextFlyout>
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{ThemeResource FonadoMuted}" FontSize="12"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Duration}" Foreground="{ThemeResource FonadoMuted}" VerticalAlignment="Center"/>
          </Grid></DataTemplate></ListView.ItemTemplate>
         </ListView>
         <TextBlock x:Name="HistorySyncStatus" Text="Auf diesem PC gespeichert · getrennt nach Konto und Firma" FontSize="12" Foreground="{ThemeResource FonadoMuted}" TextWrapping="Wrap"/>
         <TextBlock x:Name="HistoryRetentionStatus" Text="Der gemeinsame Verlauf enthält die letzten 90 Tage und bis zu 500 Anrufe." FontSize="12" Foreground="{ThemeResource FonadoMuted}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel x:Name="TeamPanel" Visibility="Collapsed" Spacing="18">
         <StackPanel Orientation="Horizontal" Spacing="12"><BitmapIcon UriSource="ms-appx:///Assets/Brand/Team.png" Width="32" Height="32" Foreground="{ThemeResource FonadoInk}"/><TextBlock x:Name="TeamCompany" Text="Dein Team" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel>
         <TextBlock Text="Internes Firmenadressbuch" Foreground="{ThemeResource FonadoMuted}"/>
         <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Aktualisieren" Click="RefreshTeamClicked"/><Button Content="Anrufprofile &amp; Rufteams" Click="ManageProfilesClicked"/></StackPanel>
         <Button x:Name="PreviewPresenceButton" Content="Statusbeispiele anzeigen" Click="PreviewPresenceClicked" Visibility="Collapsed" HorizontalAlignment="Left"/>
         <TextBox x:Name="TeamSearch" PlaceholderText="Name, E-Mail oder Nebenstelle suchen" TextChanged="TeamSearchChanged" AutomationProperties.Name="Team durchsuchen"/>
         <TextBlock x:Name="TeamMessage" Text="Lade dein Firmenverzeichnis." TextWrapping="Wrap" Foreground="{ThemeResource FonadoMuted}"/>
         <ListView x:Name="TeamList" MaxHeight="340" SelectionMode="Single" SelectionChanged="TeamSelected" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate><Grid Padding="4,10" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="19" Background="{ThemeResource FonadoTint}"><TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource FonadoAccent}" FontWeight="SemiBold"/></Border><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="{ThemeResource FonadoMuted}" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="7" Height="7" Fill="{Binding Phone.Brush}" VerticalAlignment="Center"/><TextBlock Text="{Binding Phone.Text}" Foreground="{Binding Phone.Brush}" FontSize="12"/></StackPanel><TextBlock Text="{Binding Phone.Detail}" Visibility="{Binding Phone.DetailVisibility}" Foreground="{ThemeResource FonadoMuted}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Phone.Detail}"/><TextBlock Text="{Binding AvailabilityLabel}" Foreground="{ThemeResource FonadoMuted}" FontSize="12"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate></ListView>
         <TextBlock x:Name="TeamPresenceStatus" Text="Telefonstatus unbekannt · keine aktuelle Rückmeldung" Foreground="{ThemeResource FonadoMuted}" FontSize="12" TextWrapping="Wrap"/>
         <Border x:Name="TeamDetailPanel" Visibility="Collapsed" BorderBrush="{ThemeResource FonadoLine}" BorderThickness="1" Padding="18" CornerRadius="8">
          <StackPanel Spacing="12"><TextBlock x:Name="TeamDetailName" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="TeamDetailPresence" TextWrapping="Wrap"/><TextBlock x:Name="TeamDetailText" TextWrapping="Wrap" Foreground="{ThemeResource FonadoMuted}"/>
           <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="TeamCallButton" Content="Anrufen" Click="CallTeamClicked" Style="{ThemeResource AccentButtonStyle}"/><Button x:Name="TeamFavoriteButton" Content="Als Favorit" Click="FavoriteTeamClicked"/><Button x:Name="RenameSelfButton" Content="Name ändern" Click="RenameSelfClicked" Visibility="Collapsed"/></StackPanel>
          </StackPanel>
         </Border>
        </StackPanel>
        <StackPanel x:Name="CallPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Stretch" Spacing="16" MaxWidth="380">
         <Border Width="88" Height="88" CornerRadius="44" Background="{ThemeResource FonadoTint}"><FontIcon Glyph="&#xE717;" FontSize="36" Foreground="{ThemeResource FonadoAccent}"/></Border>
         <TextBlock x:Name="CallPeer" FontSize="32" FontWeight="SemiBold" TextAlignment="Center"/>
         <TextBlock x:Name="CallPeerNumber" FontSize="14" TextAlignment="Center" Foreground="{ThemeResource FonadoMuted}" Visibility="Collapsed"/>
         <TextBlock x:Name="CallStatus" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
         <TextBlock x:Name="CallDuration" FontSize="22" TextAlignment="Center" Foreground="{ThemeResource FonadoAccent}"/>
         <StackPanel x:Name="CallWave" Height="24" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" AutomationProperties.Name="Gesprächsaktivität"><Rectangle Width="4" Height="4" RadiusX="2" RadiusY="2" Fill="{ThemeResource FonadoAccent}" VerticalAlignment="Center"/><Rectangle Width="4" Height="4" RadiusX="2" RadiusY="2" Fill="{ThemeResource FonadoAccent}" VerticalAlignment="Center"/><Rectangle Width="4" Height="4" RadiusX="2" RadiusY="2" Fill="{ThemeResource FonadoAccent}" VerticalAlignment="Center"/><Rectangle Width="4" Height="4" RadiusX="2" RadiusY="2" Fill="{ThemeResource FonadoAccent}" VerticalAlignment="Center"/><Rectangle Width="4" Height="4" RadiusX="2" RadiusY="2" Fill="{ThemeResource FonadoAccent}" VerticalAlignment="Center"/></StackPanel>
         <TextBlock x:Name="OriginalCallLabel" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource FonadoMuted}" Visibility="Collapsed"/>
         <Button x:Name="AnswerButton" Content="Annehmen" Click="AnswerClicked" Visibility="Collapsed" HorizontalAlignment="Stretch" Background="{ThemeResource FonadoCallGreen}" Foreground="{ThemeResource FonadoCallInk}"/>
         <Button x:Name="MuteButton" Content="Stummschalten" Click="MuteClicked" HorizontalAlignment="Stretch"/>
         <Button x:Name="HoldButton" Content="Halten" Click="HoldClicked" HorizontalAlignment="Stretch"/>
         <Button x:Name="TransferButton" Content="Weiterleiten / Rückfrage" Click="TransferClicked" HorizontalAlignment="Stretch"/>
         <Button x:Name="CompleteTransferButton" Content="Gespräche verbinden" Click="CompleteTransferClicked" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" Visibility="Collapsed"/>
         <Button x:Name="ReturnOriginalButton" Content="Zurück zum ursprünglichen Gespräch" Click="ReturnOriginalClicked" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
         <Button x:Name="CallKeypadButton" Content="Tastenfeld" Click="ShowDialpadClicked" HorizontalAlignment="Stretch"/>
         <Button x:Name="HangUpButton" Content="Auflegen" Click="HangUpClicked" HorizontalAlignment="Stretch" Background="{ThemeResource FonadoCallDanger}" Foreground="{ThemeResource FonadoDangerInk}"/>
        </StackPanel>
       </Grid>
      </Grid>
     </ScrollViewer>
        <Grid x:Name="ContactsPanel" Visibility="Collapsed" RowSpacing="18" Padding="36">
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <TextBlock Text="Deine Kontakte" FontSize="26" FontWeight="SemiBold"/>
         <SelectorBar x:Name="ContactsNavigation" Grid.Row="1" SelectionChanged="ContactsNavigationChanged" HorizontalAlignment="Left" AutomationProperties.Name="Kontaktbereich auswählen">
          <SelectorBarItem Text="Kontaktliste" IsSelected="True"/>
          <SelectorBarItem x:Name="ContactSourcesTab" Text="Kontaktquellen"/>
         </SelectorBar>
         <TextBlock x:Name="ContactsViewDescription" Grid.Row="2" Text="Wähle einen Kontakt zum Anrufen oder speichere eine Rufnummer über den Stern in deinen Favoriten." TextWrapping="Wrap" Foreground="{ThemeResource FonadoMuted}"/>
         <Grid x:Name="ContactsListPanel" Grid.Row="3" RowSpacing="18">
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <TextBox x:Name="ContactsSearch" PlaceholderText="Name oder Rufnummer suchen" TextChanged="ContactsSearchChanged" AutomationProperties.Name="Kontakte durchsuchen"/>
         <TextBlock x:Name="ContactsEmpty" Grid.Row="1" Text="Noch keine Kontakte geladen." Foreground="{ThemeResource FonadoMuted}" TextWrapping="Wrap" Margin="0,24" VerticalAlignment="Top"/>
         <ListView x:Name="ContactsList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="ContactClicked" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListView.ItemTemplate><DataTemplate>
           <Grid Padding="4,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="19" Background="{ThemeResource FonadoTint}"><TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource FonadoAccent}" FontWeight="SemiBold"/></Border>
            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="{ThemeResource FonadoMuted}" TextTrimming="CharacterEllipsis"/></StackPanel>
            <Button Grid.Column="2" Width="38" Height="38" Padding="8" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Tag="{Binding Contact}" IsEnabled="{Binding CanAddFavorite}" Click="ContactFavoriteClicked" ToolTipService.ToolTip="{Binding FavoriteAction}" AutomationProperties.Name="{Binding FavoriteAction}">
             <FontIcon Glyph="{Binding FavoriteGlyph}" FontSize="18" Foreground="{ThemeResource FonadoAccent}"/>
            </Button>
           </Grid>
          </DataTemplate></ListView.ItemTemplate>
         </ListView>
         </Grid>
         <ScrollViewer x:Name="ContactSourcesPanel" Grid.Row="3" Visibility="Collapsed" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
         <StackPanel Spacing="18">
         <Border BorderBrush="{ThemeResource FonadoLine}" BorderThickness="1" CornerRadius="8" Padding="18">
          <StackPanel Spacing="12">
           <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock Text="Outlook-Kontakte" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="OutlookAccount" Foreground="{ThemeResource FonadoMuted}" TextTrimming="CharacterEllipsis"/></StackPanel><ProgressRing x:Name="OutlookProgress" Grid.Column="1" Width="24" Height="24" IsActive="False" Visibility="Collapsed"/></Grid>
           <TextBlock x:Name="OutlookStatus" TextWrapping="Wrap" Foreground="{ThemeResource FonadoMuted}" FontSize="13"/>
           <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ConnectOutlookButton" Content="Outlook verbinden" Click="ConnectOutlookClicked" Style="{ThemeResource AccentButtonStyle}"/><Button x:Name="RefreshOutlookButton" Content="Aktualisieren" Click="RefreshOutlookClicked" Visibility="Collapsed"/><Button x:Name="DisconnectOutlookButton" Content="Verbindung trennen" Click="DisconnectOutlookClicked" Visibility="Collapsed"/></StackPanel>
           <Button x:Name="MicrosoftPortalButton" Content="Firmenverbindung im Kundenbereich" Click="MicrosoftPortalClicked"/>
           <TextBlock Text="Lesezugriff auf deine Postfachkontakte · auf diesem PC geschützt gespeichert" FontSize="12" Foreground="{ThemeResource FonadoMuted}" TextWrapping="Wrap"/>
          </StackPanel>
         </Border>
          <Border BorderBrush="{ThemeResource FonadoLine}" BorderThickness="1" CornerRadius="8" Padding="18">
           <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10"><SymbolIcon Symbol="Contact"/><TextBlock Text="Windows-Kontakte" FontSize="18" FontWeight="SemiBold"/></StackPanel>
            <TextBlock Text="Lade Kontakte aus dem Windows-Adressbuch in deine Kontaktliste." TextWrapping="Wrap" Foreground="{ThemeResource FonadoMuted}" FontSize="13"/>
            <Button Content="Windows-Kontakte laden" Click="LoadContactsClicked"/>
            <HyperlinkButton Content="Kontaktezugriff in Windows verwalten" NavigateUri="ms-settings:privacy-contacts" Padding="0" HorizontalAlignment="Left"/>
           </StackPanel>
          </Border>
          <Border BorderBrush="{ThemeResource FonadoLine}" BorderThickness="1" CornerRadius="8" Padding="18">
           <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="10"><SymbolIcon Symbol="Document"/><TextBlock Text="vCard" FontSize="18" FontWeight="SemiBold"/></StackPanel>
            <TextBlock Text="Öffne eine vCard-Datei (.vcf), um ihre Kontakte zur Liste hinzuzufügen." TextWrapping="Wrap" Foreground="{ThemeResource FonadoMuted}" FontSize="13"/>
            <Button Content="vCard öffnen" Click="ImportContactsClicked"/>
           </StackPanel>
          </Border>
         </StackPanel>
         </ScrollViewer>
        </Grid>
     </Grid>
    </ContentControl>
    <StackPanel Grid.Row="2" Spacing="8" Margin="28,0,28,16">
     <ProgressRing x:Name="Progress" IsActive="False" Visibility="Collapsed" Width="24" Height="24" HorizontalAlignment="Left"/>
     <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Error"/>
    </StackPanel>
   </Grid>
  </NavigationView>
 </Grid>
</Window>
