<Application x:Class="Fonado.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="BrandResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="FonadoFont">ms-appx:///Assets/Fonts/Manrope-Variable.ttf#Manrope</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Manrope-Variable.ttf#Manrope</FontFamily>
            <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource FonadoFont}" /></Style>
            <Style TargetType="NavigationViewItem"><Setter Property="FontWeight" Value="SemiBold" /></Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
